# ---- dependencies ----
node_modules/
.pnp/
.pnp.js
.yarn/

# ---- build output ----
dist/
dist-ssr/
.vite/
*.local

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- environment ----
# Nothing secret should be needed for the static build, but keep these out
# of git anyway so a future backend (Flask / Supabase) can't leak keys.
.env
.env.*
!.env.example

# ---- caches ----
.eslintcache
.cache/
.turbo/
*.tsbuildinfo

# ---- migration scratch ----
# `npm run scrape` writes here. It is throwaway: raw WordPress HTML, the media
# manifest, and unoptimized downloads. Curated output belongs in src/content
# and public/media, both of which ARE committed.
scripts/.scratch/

# ---- editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~
